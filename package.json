{
  "name": "playwright-e2e-saucedemo",
  "version": "1.0.0",
  "private": true,
  "description": "Suite E2E automatizada con Playwright y TypeScript sobre SauceDemo: Page Object Model, fixtures, pruebas dirigidas por datos y ejecución cross-browser en CI.",
  "author": "David Coya Moreno",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Blistahub/playwright-e2e-saucedemo.git"
  },
  "homepage": "https://blistahub.github.io/playwright-e2e-saucedemo/",
  "keywords": [
    "qa",
    "testing",
    "playwright",
    "typescript",
    "e2e",
    "page-object-model",
    "test-automation"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:humo": "playwright test --grep @humo",
    "test:hallazgos": "playwright test --grep @hallazgo",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verificar": "node tools/verificar.mjs",
    "calidad": "npm run typecheck && npm run lint && npm run verificar",
    "evidencias": "node tools/capturar-evidencias.mjs",
    "sitio": "node tools/preparar-sitio.mjs trazas",
    "carrusel": "node tools/generar-carrusel.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "eslint": "^10.8.1",
    "eslint-plugin-playwright": "^2.11.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.67.0"
  }
}
