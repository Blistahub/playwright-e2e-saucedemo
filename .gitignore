node_modules/

# Artefactos de ejecución de Playwright: se regeneran en cada run y no se versionan.
playwright-report/
test-results/
blob-report/
playwright/.cache/

# El sitio de GitHub Pages y sus piezas se ensamblan en cada despliegue.
# Las evidencias de `evidencias/` sí se versionan: son la ilustración de los
# reportes de defecto y se regeneran a mano con `npm run evidencias`.
_sitio/
trazas/
trazas-salida/
trazas.json

# Entorno local
.env
.env.local

# Sistema operativo y editores
Thumbs.db
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Materiales de difusion: se regeneran con npm run carrusel.
marketing/
